# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
# Model: claude-opus-4-8 (kuchli, qimmatroq) | claude-sonnet-5 | claude-haiku-4-5 (arzon)
LLM_MODEL=claude-opus-4-8
# low | medium | high | xhigh | max  — past = arzon va tez
LLM_EFFORT=medium

# ---- Telegram ----
# @BotFather'dan olingan Radar bot tokeni
RADAR_BOT_TOKEN=123456:ABC...
# Gruppa ID (manfiy son, masalan -1001234567890)
GROUP_CHAT_ID=-1001234567890
# Forum (topics) rejimidagi gruppada mavzu ID'lari. Bo'sh qoldirsangiz — asosiy oqimga yozadi.
TOPIC_NEWS_ID=
TOPIC_IDEAS_ID=

# ---- Jadval (cron, TZ bo'yicha) ----
TZ=Asia/Tashkent
CRON_NEWS=0 9 * * *
CRON_IDEA=0 20 * * *

# ---- Sozlamalar ----
# Nechta yangilik postga tushsin
NEWS_COUNT=5
# Necha soat ichidagi yangiliklar hisobga olinsin
NEWS_WINDOW_HOURS=36
